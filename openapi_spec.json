{
  "openapi": "3.1.0",
  "info": {
    "title": "Hla Compatibility Matcher API",
    "description": "Demonstration API for arbitrary numeric threshold checks; not HLA compatibility assessment or validated clinical decision support.",
    "version": "3.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "Service health check"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counts (not Prometheus text)",
        "responses": {
          "200": {
            "description": "In-memory task and audit counts"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate a demonstration numeric payload with arbitrary thresholds",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demonstration dossier with HMAC-chained audit identifier"
          }
        },
        "security": [
          {
            "OperatorToken": []
          }
        ]
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock response; no model inference",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        },
        "security": [
          {
            "OperatorToken": []
          }
        ]
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "In-memory HMAC-chained audit entries and verification result"
          }
        },
        "security": [
          {
            "OperatorToken": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OperatorToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Set API_ACCESS_TOKEN in the server environment."
      }
    }
  }
}
