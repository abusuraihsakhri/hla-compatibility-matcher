# HLA Compatibility Matcher Environment Configuration
# Copy this file to .env and customize values for your deployment

# HMAC-SHA256 Audit Trail Secret Key
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock

# API bearer token required for /api/audit, /api/chat and /api/audit/logs.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set a new value in .env; no default or example credential is provided.
API_ACCESS_TOKEN=

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
